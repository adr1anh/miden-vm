use {
    PUBLIC_INPUTS_ADDRESS_PTR,
} from miden::core::stark::constants
use miden::core::stark::types
use miden::core::stark::public_inputs
use miden::core::stark::random_coin
use miden::core::sys::vm::layout

# PUBLIC INPUTS PROCESSING FOR MIDEN VM RECURSIVE VERIFIER
# =================================================================================================
#
# This module stages the VM statement and absorbs `[CLAIM_HASH | deferred_root]` into Fiat-Shamir,
# matching `vm::statement::observe`. CLAIM_HASH binds K_entry, R_E, and stack I/O under claim
# domain v2. The outer-LogUp correction `c_total` is computed in step II after sampling aux
# randomness.
#
# Memory layout populated (low -> high addresses):
#
#   boundary_inputs_ptr --> [ environment_root (4 felts, copied Chiplets public values) ]
#                           [ deferred_root  (4 felts) ]
#
#   pi_ptr             -->  [ Core36: I || O || K_entry, as 36 EF slots ]
#                           [ Chiplets4: R_E, as 4 EF slots ]
#
#   anchor             -->  [ aux_rand: beta0,beta1,alpha0,alpha1 ]   AUX_RAND_ELEM_PTR (sampled
#                                                                     from the transcript in step II)
#
# The outer-LogUp boundary correction accumulated at `C_TOTAL_PTR` is the signed sum of one
# inverted bus term per boundary interaction:
#
#     c_total = 1 / d(LibraryOpen, [0, R_E[4], N0[4]])   (Open seed, +1)
#             + 1 / d(LogDeferredRoot, [0, 0, 0, 0])     (initial,   +1)
#             − 1 / d(LogDeferredRoot, deferred_root)     (final,     −1)
#
# where the bus-message denominator is `d(bus, w) = (α + (bus + 1)·γ) + msg(w)`, the prefix
# scale `bus + 1` is the matching `BUS_ID_*_PLUS_ONE` constant, `γ = β^MAX_MESSAGE_WIDTH`, and
# `msg(w) = Σ_j w_j·β^j`. The fixed N0 is `Namespace::initial()`, independent of R_E and nonzero.
# LibraryOpen has depth at β^0, R_E at β^1..β^4, and N0 at β^5..β^8. The zero initial deferred
# message gives `msg = 0`. The correction is computed in step II (`observe_aux_trace`) from
# the FS-sampled `α, β` and staged boundary inputs; `observe_aux_trace` then asserts
# `c_total + sum_i(n_i * sigma_prime_i) == 0` against the normalized per-AIR LogUp sums.
# The two positive terms are added and the final deferred term is subtracted.
#
# Fiat-Shamir absorption order (`vm::statement::observe`): one statement block
#   1. CLAIM_HASH + deferred_root                     (4 + 4 = 8 felts)
# where CLAIM_HASH is the caller-provided execution-claim commitment, authenticated against
# `K_entry ‖ R_E ‖ stack_inputs ‖ stack_outputs` before this procedure runs.
# `init_seed` folds RELATION_DIGEST into the initial transcript chaining word, so the state after
# this block realizes `H(RELATION_DIGEST ‖ CLAIM_HASH ‖ D)`.
# The raw public values are copied into ACE READ without being separately absorbed.
#
# Data sources:
#   - claim region: verifier memory at `claim_ptr`, populated from advice and authenticated against
#     the caller-provided claim commitment before any fields are used.
#   - deferred_root: advice (4 canonical felts), loaded by `stage_boundary_inputs`.
#
# CONSTANTS
# =================================================================================================

# ACE public inputs in AIR order: Core36 (I || O || K_entry), then Chiplets4 (R_E).

const NUM_FIXED_LEN_PUBLIC_INPUTS = 40

# Number of AIR instances in the Miden VM statement.
const NUM_MIDEN_AIRS = 4

# Bus prefix scale factors: `prefix_id = α + (BusId + 1)·γ` with `γ = β^16`.
const BUS_ID_LOG_DEFERRED_ROOT_PLUS_ONE         = 3   # LogDeferredRoot (2) + 1
const BUS_ID_LIBRARY_OPEN_PLUS_ONE              = 40  # LibraryOpen (39) + 1

# Frozen `namespace_initial` forward-order vector from core/tests/fixtures/librarytree-vectors.txt.
# This is Namespace::initial() = H_ENV_INITIAL_NAMESPACE([]), never a caller-selected namespace.
const INITIAL_NAMESPACE = [6554493223373468461, 8954317118201261599, 3332049382679531586, 698300210645908104]

# Word offsets into the boundary-inputs block at `boundary_inputs_ptr`:
#   [ environment_root (+0) | deferred_root (+4) ].
const BOUNDARY_INPUTS_ENVIRONMENT_OFFSET = 0
const BOUNDARY_INPUTS_DEFERRED_OFFSET   = 4


# CONSTANTS GETTERS
# =================================================================================================

pub proc get_num_fixed_len_public_inputs() -> u8
    push.NUM_FIXED_LEN_PUBLIC_INPUTS
end

# MAIN PROCEDURE
# =================================================================================================

#! Processes the public inputs (step I of the verifier).
#!
#! See the module banner for the memory layout and canonical Fiat-Shamir schedule.
#!
#! Precondition:  the transcript buffer contains the trusted preprocessed-trace commitment
#!                observed by `init_seed`.
#! Postcondition: the transcript input buffer holds the AIR-shape values. The generic verifier
#!                observes the main-trace commitment next and flushes before sampling.
#!
#! Input:  [...]
#! Output: [...]
pub proc process_public_inputs()
    # 1) Store the ACE public-input pointer.
    exec.get_num_fixed_len_public_inputs
    exec.layout::aux_rand_elem_ptr
    exec.public_inputs::compute_and_store_public_inputs_address
    # => [...]

    # 2) Absorb [CLAIM_HASH | D].
    padw exec.layout::claim_commitment_ptr mem_loadw_le
    # => [CLAIM_HASH, ...]
    exec.absorb_claim_and_deferred_into_fs
    # => [...]

    # 3) Copy Core36 and Chiplets4 into ACE READ. CLAIM_HASH already binds these values.
    exec.load_public_inputs
    # => [...]

    # 4) Observe the AIR count and per-AIR log heights.
    exec.observe_miden_air_shape
    # => [...]
end

#! Stages VM boundary data before the transcript starts.
#!
#! Precondition: the claim region is populated and authenticated.
#!
#! Writes:
#! - +0: environment_root from claim +4
#! - +4: deferred_root from advice
#!
#! Input:  [...]
#! Output: [...]
pub proc stage_boundary_inputs()
    # environment_root: claim region (+4) -> boundary_inputs (+0).
    padw exec.layout::claim_ptr add.4 mem_loadw_le
    # => [R_E, ...]
    exec.layout::boundary_inputs_ptr mem_storew_le
    # => [R_E, ...]

    # deferred_root from advice -> boundary_inputs (+4), loaded over the dead R_E word.
    adv_loadw
    exec.layout::boundary_inputs_ptr add.BOUNDARY_INPUTS_DEFERRED_OFFSET mem_storew_le dropw
    # => [...]
end

# HELPER PROCEDURES
# =================================================================================================

#! Computes `γ = β^MAX_MESSAGE_WIDTH` for per-bus domain separation and stores it at
#! BUS_GAMMA_PTR as `[γ0, γ1, 0, 0]`.
#!
#! The four squarings below reach `β^16`; `MAX_MESSAGE_WIDTH` is hardcoded as 16 here, guarded
#! by the `MIDEN_MAX_MESSAGE_WIDTH` tripwire in `crates/air/source/src/vm/constraints/lookup/messages.rs`.
#!
#! Input:  [...]
#! Output: [...]
proc compute_bus_gamma()
    exec.push_beta
    # => [β0, β1, ...]
    dup.1 dup.1 ext2mul   # β^2
    dup.1 dup.1 ext2mul   # β^4
    dup.1 dup.1 ext2mul   # β^8
    dup.1 dup.1 ext2mul   # β^16 = γ
    push.0.0 movup.3 movup.3
    exec.layout::bus_gamma_ptr mem_storew_le
    dropw
end

#! Pushes the auxiliary randomness β onto the stack.
#!
#! Input:  [...]
#! Output: [β0, β1, ...]
proc push_beta() -> types::QuadFelt
    exec.layout::aux_rand_elem_ptr add.1 mem_load
    exec.layout::aux_rand_elem_ptr mem_load
end

#! Computes the bus prefix `α + i·γ` for bus scale factor `i = bus_id + 1`.
#!
#! Input:  [i, ...]
#! Output: [p0, p1, ...]
proc push_alpha_plus_i_gamma(bus_id_plus_one: u8) -> types::QuadFelt
    dup
    exec.layout::bus_gamma_ptr add.1 mem_load mul
    # => [i·γ1, i, ...]
    swap
    exec.layout::bus_gamma_ptr mem_load mul
    # => [i·γ0, i·γ1, ...]
    exec.layout::aux_rand_elem_ptr add.3 mem_load
    exec.layout::aux_rand_elem_ptr add.2 mem_load
    # => [α0, α1, i·γ0, i·γ1, ...]
    ext2add
    # => [p0, p1, ...]
end

#! Folds a 4-felt message word into `msg = m0 + m1·β + m2·β^2 + m3·β^3` via Horner
#! evaluation, consuming the word from the stack.
#!
#! Input:  [m0, m1, m2, m3, ...]
#! Output: [msg0, msg1, ...]
proc fold_digest_word(digest: types::Digest) -> types::QuadFelt
    movup.3 push.0 swap
    # => [m3, 0, m0, m1, m2, ...]
    exec.push_beta ext2mul
    movup.4 add
    # => [acc0, acc1, m0, m1, ...]
    exec.push_beta ext2mul
    movup.3 add
    # => [acc0, acc1, m0, ...]
    exec.push_beta ext2mul
    movup.2 add
    # => [msg0, msg1, ...]
end

#! Computes the inverted Library Open seed denominator for `[0, R_E[4], N0[4]]`.
#!
#! The fixed initial namespace occupies coefficients β^5..β^8, and the public environment root
#! occupies β^1..β^4. The depth-zero coefficient is zero. This matches `LibraryOpenMsg::encode`
#! and `emit_open_seed` exactly, including the positive sign supplied by the caller.
#!
#! Input:  [...]
#! Output: [inv_term0, inv_term1, ...]
proc fold_root_open_inv_term() -> types::QuadFelt
    padw exec.layout::boundary_inputs_ptr add.BOUNDARY_INPUTS_ENVIRONMENT_OFFSET mem_loadw_le
    # => [r0, r1, r2, r3, ...]
    push.INITIAL_NAMESPACE
    exec.fold_digest_word
    # => [namespace_fold0, namespace_fold1, r0, r1, r2, r3, ...]
    # namespace_fold = n0 + n1·β + n2·β^2 + n3·β^3.

    exec.push_beta ext2mul
    movup.5 add
    exec.push_beta ext2mul
    movup.4 add
    exec.push_beta ext2mul
    movup.3 add
    exec.push_beta ext2mul
    movup.2 add
    # => [words_fold0, words_fold1, ...]
    # words_fold = r0 + r1·β + r2·β^2 + r3·β^3 + n0·β^4 + ... + n3·β^7.

    exec.push_beta ext2mul
    # => [msg0, msg1, ...]   (depth=0 at β^0; shift the eight word coefficients by one)
    push.BUS_ID_LIBRARY_OPEN_PLUS_ONE
    exec.push_alpha_plus_i_gamma
    ext2add ext2inv
    # => [inv_term0, inv_term1, ...]
end

#! Reads the canonical word `[d0, d1, d2, d3]` at `boundary_inputs_ptr + offset` (written in step I)
#! and computes the inverted bus term
#!     inv_term = 1 / ((α + i·γ) + msg(d))
#! where `i = bus_id_plus_one` and `msg(d) = Σ_{j<4} d_j·β^j`. The caller adds (request) or
#! subtracts (response) the result from the boundary accumulator.
#!
#! Input:  [bus_id_plus_one, offset, ...]
#! Output: [inv_term0, inv_term1, ...]
proc fold_boundary_word_inv_term(bus_id_plus_one: u8, offset: u8) -> types::QuadFelt
    padw
    # => [0, 0, 0, 0, bus_id, offset, ...]
    exec.layout::boundary_inputs_ptr
    dup.6 add
    # => [target, 0, 0, 0, 0, bus_id, offset, ...]
    mem_loadw_le
    # => [d0, d1, d2, d3, bus_id, offset, ...]

    exec.fold_digest_word
    # => [msg0, msg1, bus_id, offset, ...]

    movup.2
    # => [bus_id, msg0, msg1, offset, ...]
    exec.push_alpha_plus_i_gamma
    # => [p0, p1, msg0, msg1, offset, ...]
    ext2add ext2inv
    # => [inv_term0, inv_term1, offset, ...]

    movup.2 drop
    # => [inv_term0, inv_term1, ...]
end

#! Computes the outer-LogUp boundary correction `c_total` and stores it at `C_TOTAL_PTR`
#! (step II). Requires the aux randomness to have been sampled into `AUX_RAND_ELEM_PTR` by
#! `generate_aux_randomness` first.
#!
#! Derives `γ = β^16`, then folds the singleton root Open seed and the initial/final deferred
#! terms. R_E and the deferred root come from the boundary-inputs block; N0 is fixed verifier
#! setup. Mirrors the module banner's `c_total` definition and `vm::statement::eval_external`.
#!
#! Input:  [...]
#! Output: [...]
pub proc compute_outer_logup_correction()
    # γ = β^16 into BUS_GAMMA_PTR.
    exec.compute_bus_gamma
    # => [...]

    # Positive root Open seed: +1 / d(LibraryOpen, [0, R_E[4], N0[4]]).
    exec.fold_root_open_inv_term
    # => [acc0, acc1, ...]

    # Positive log-deferred initial term: +1 / (α + 3γ) (the message is all zeros).
    push.BUS_ID_LOG_DEFERRED_ROOT_PLUS_ONE
    exec.push_alpha_plus_i_gamma
    ext2inv
    ext2add
    # => [acc0, acc1, ...]

    # Negative log-deferred final term: −1 / ((α + 3γ) + msg(deferred_root)).
    push.BOUNDARY_INPUTS_DEFERRED_OFFSET push.BUS_ID_LOG_DEFERRED_ROOT_PLUS_ONE
    exec.fold_boundary_word_inv_term
    neg swap neg swap
    ext2add
    # => [acc0, acc1, ...]   (acc = Open seed + initial − final)

    #    Store c_total once.
    exec.layout::c_total_ptr mem_store
    exec.layout::c_total_ptr add.1 mem_store
    # => [...]
end

#! Observes `[CLAIM_HASH | D]` through the FS stream, mirroring `vm::statement::observe` after the
#! framework-bound preprocessed commitment. `D` is read from the boundary-inputs window.
#!
#! Input:  [CLAIM_HASH, ...]
#! Output: [...]
proc absorb_claim_and_deferred_into_fs(claim_hash: types::Digest)
    exec.random_coin::eidos_observe_word

    # D from the boundary-inputs window.
    padw exec.layout::boundary_inputs_ptr add.BOUNDARY_INPUTS_DEFERRED_OFFSET mem_loadw_le
    exec.random_coin::eidos_observe_word
    # => [...]
end

#! Copies all 40 public values into ACE READ in canonical AIR order: Core36 `I || O || K_entry`,
#! then Chiplets4 `R_E`. Each base felt occupies an extension slot `(value, 0)` at offset `2*i`.
#!
#! The values are public inputs for the constraint checks only; they are NOT absorbed into the
#! FS transcript (the transcript binds them via CLAIM_HASH).
#!
#! Input:  [...]
#! Output: [...]
proc load_public_inputs()
    padw padw padw
    # => [SCRATCH(12), ...]
    exec.layout::claim_ptr add.8
    movdn.12
    mem_load.PUBLIC_INPUTS_ADDRESS_PTR
    movdn.12
    # => [SCRATCH(12), pi_ptr, claim_io_ptr, ...]

    # The first 32 values are I || O from claim +8 through claim +40.
    repeat.4
        exec.public_inputs::load_base_store_extension_double_word_from_mem
    end
    # => [SCRATCH'(12), pi_ptr + 64, claim_io_ptr + 32, ...]

    # Resume at claim +0 to append K_entry || R_E as the final eight public values.
    movup.13 drop
    exec.layout::claim_ptr movdn.13
    exec.public_inputs::load_base_store_extension_double_word_from_mem
    # => [SCRATCH''(12), pi_ptr + 80, claim_ptr + 8, ...]

    dropw dropw dropw drop drop
    # => [...]
end

#! Observe the Miden AIR shape into the Fiat-Shamir transcript.
#!
#! This matches the framework's shape observation: instance count followed by per-AIR log heights in
#! instance order.
#!
#! Input:  [...]
#! Output: [...]
proc observe_miden_air_shape()
    push.NUM_MIDEN_AIRS exec.random_coin::observe_felt
    exec.layout::get_core_trace_length_log exec.random_coin::observe_felt
    exec.layout::get_chiplets_trace_length_log exec.random_coin::observe_felt
    exec.layout::get_eidos_compression_trace_length_log exec.random_coin::observe_felt
    exec.layout::get_and8_lookup_trace_length_log exec.random_coin::observe_felt
end
